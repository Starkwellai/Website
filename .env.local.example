# reCAPTCHA Configuration
# ローカル環境でreCAPTCHAを動作させるには、以下のキーを設定してください
# 
# 1. Google reCAPTCHA Admin Console (https://www.google.com/recaptcha/admin) にアクセス
# 2. 新しいサイトを作成（reCAPTCHA v3を選択）
# 3. ドメインに「localhost」を追加
# 4. 取得したキーを以下に設定

# フロントエンド用の公開キー（Site Key）
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=your_site_key_here

# バックエンド用の秘密キー（Secret Key）
RECAPTCHA_SECRET_KEY=your_secret_key_here

# Google Maps Embed API（施設詳細ページの地図表示）
# https://console.cloud.google.com/ で Maps Embed API を有効化しキーを取得
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
